# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000

# MongoDB Atlas connection string (Atlas clusters support transactions).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crowdgrid?retryWrites=true&w=majority

# Only if you get "querySrv ECONNREFUSED": ask public DNS servers for the Atlas address
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
QR_SECRET=change-me-too

# Frontend origins allowed by CORS (comma separated). Your Vercel project's own
# addresses (VERCEL_PROJECT.vercel.app and its preview links) are always allowed.
# VERCEL_PROJECT=crowdgrid-frontend
# Frontend origins allowed by CORS (comma separated)
CLIENT_ORIGIN=http://localhost:5173

# strict  = meal passes only scan inside their meal window (spec behaviour)
# relaxed = meal passes scan any time on their day (handy for a daytime demo)
PASS_TIME_WINDOWS=strict

# Password for every demo account created by `npm run seed` (8+ characters, a letter and a number).
# Never commit the real value.
SEED_PASSWORD=
# Optional: fixed 6-digit corporate access code for the seeded summit (random when empty)
SEED_ACCESS_CODE=
